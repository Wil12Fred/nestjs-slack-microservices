# HTTP port (Swagger UI at /api/docs)
PORT=3002

# Base URL of ms_auth; every request's bearer token is checked against
# ${AUTH_HOST}/api/auth/login
AUTH_HOST=http://localhost:3001

# Redis, used as the Bull queue that hands new messages to ms_socket
REDIS_HOST=localhost
REDIS_PORT=6379

# MySQL via TypeORM. All of these are required by the config validator,
# even the migration ones, which are not used yet.
TYPEORM_CONNECTION=mysql
TYPEORM_HOST=localhost
TYPEORM_PORT=3306
TYPEORM_DATABASE=slack_admin
TYPEORM_USERNAME=slack
TYPEORM_PASSWORD=change-me
# true creates/updates the tables on start; there are no migrations
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false
TYPEORM_ENTITIES=dist/**/*.model.js
TYPEORM_MIGRATIONS=dist/migrations/*.js
TYPEORM_MIGRATIONS_DIR=src/migrations
TYPEORM_MIGRATIONS_TABLE_NAME=migrations
