# HTTP port (Swagger UI at /api/auth/docs)
PORT=3001

# MySQL (the variable prefix really is MYSQ_, not MYSQL_)
MYSQ_DB_HOST=localhost
MYSQ_DB_PORT=3306
MYSQ_DB_USERNAME=slack
MYSQ_DB_PASSWORD=change-me
MYSQ_DB_DATABASE=slack_auth

# JWT signing; use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me
# Any value accepted by jsonwebtoken, e.g. 3600 (seconds) or 1d
JWT_EXPIRATION_TIME=1d
