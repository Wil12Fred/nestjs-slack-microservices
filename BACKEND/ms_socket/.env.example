# Socket.IO port
APP_PORT=5300

# Redis: the Bull queue fed by ms_admin, and the cache store
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=60

# Base URL of ms_auth. Every socket's bearer token is validated against
# ${AUTH_HOST}/api/auth/login; a client ms_auth rejects is disconnected.
AUTH_HOST=http://localhost:3001

# Base URL of ms_admin (its routes live under /api). Before a socket joins a
# channel room, its own token is sent to ${ADMIN_HOST}/api/channel/<id>;
# anything but a 200 (not a member, no such channel) refuses the join.
ADMIN_HOST=http://localhost:3002
