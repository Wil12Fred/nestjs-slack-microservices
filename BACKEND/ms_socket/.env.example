# Socket.IO port
APP_PORT=5300

# Redis: the Bull queue fed by ms_admin, and the cache store
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=60

# Base URL of ms_auth. Every socket's bearer token is validated against
# ${AUTH_HOST}/api/auth/login; a client ms_auth rejects is disconnected.
AUTH_HOST=http://localhost:3001
