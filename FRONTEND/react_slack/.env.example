# Base URLs of the two REST services, including the /api prefix
REACT_APP_API_AUTH_ENDPOINT=http://localhost:3001/api
REACT_APP_API_ADMIN_ENDPOINT=http://localhost:3002/api

# Socket.IO server (ms_socket)
REACT_APP_SOCKET_HOST=http://localhost
REACT_APP_SOCKET_PORT=5300

# Account (tenant) id sent in the `account` header of every request.
# Create one first with POST /api/accounts on ms_auth.
REACT_APP_ACCOUNT=1
